  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 8
  m_EditorClassIdentifier: 
  questionText: How can we avoid backlash errors in a spherometer
  referenceImage: {fileID: 0}
  explanationText: When we rotate the screw very fast while taking the reading there
    is some slipping between the screw threads which results in backlash error. To
    avoid it, rotate the screw slowly.
  options:
  - 'By rotating the screw slowly '
  - 'By rotating the screw fast '
  - By rotating the screw quickly in one direction and then reversing the direction
    after the halt
  - 'None of the above '
  correctOptionIndex: 1
